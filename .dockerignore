# Docker build context must never send local credentials.
.git
.gitignore
**/node_modules
**/.next
**/dist
**/coverage
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.sqlite
**/*.dump
**/*.bak
**/test-results
**/playwright-report
*.log
.DS_Store

**/*.sofraenc
**/*.pg.enc
**/*.backup

# Local Compose credentials may be named staging.env rather than .env.local.
**/*.env
