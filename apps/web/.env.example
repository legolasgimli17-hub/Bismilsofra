# Frontend API URL; 127.0.0.1 (not localhost) must match CORS_ORIGIN
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# OIDC / Auth0 single-page app (public client; never put secrets here)
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=

# Optional trusted photo CDN domain (hostname only, without protocol).
# Live restaurant photos should be owned/licensed and served from this trusted host.
# Example: NEXT_PUBLIC_IMAGE_CDN_HOST=assets.bismilsofra.example
# NEXT_PUBLIC_IMAGE_CDN_HOST=


# REQUIRED for rendering uploaded images from your own CDN:
# NEXT_PUBLIC_IMAGE_CDN_HOST=assets.yourdomain.example
# This is a public hostname only, NOT a secret or S3 credential.
