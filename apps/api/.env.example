# Copy to .env and set real values. NEVER commit .env or any token.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sofra:change-this-password@127.0.0.1:5432/bismil_sofra
# Managed identity provider with email verification; do NOT use a custom shared-secret JWT.
OIDC_ISSUER=https://REPLACE-WITH-TRUSTED-PROVIDER.example.com/
OIDC_AUDIENCE=REPLACE-WITH-PROVIDER-AUDIENCE
OIDC_JWKS_URL=https://REPLACE-WITH-TRUSTED-PROVIDER.example.com/.well-known/jwks.json
# Explicitly allowed browser origin (no wildcard). Set to your production domain later.
CORS_ORIGIN=http://127.0.0.1:3000
# Optional webhook alert bridge for production-grade restaurant notification channel.
# Leave unset until your own trusted, HTTPS webhook receiver verifies signatures and deduplicates event IDs.
# ALERT_WEBHOOK_URL=https://your-own-provider.example/sofra-events
# ALERT_WEBHOOK_SECRET=PUT_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS_HERE

# Independent restaurant escalation (separate provider from ALERT_WEBHOOK_URL).
# Worker sends an HMAC-signed reminder if an order remains unaccepted.
# Receiver MUST dedupe the stable x-sofra-event-id header. Do not use the
# same provider/endpoint as the primary alert. Configure a genuine fallback.
# ESCALATION_WEBHOOK_URL=https://second-trusted-provider.example/api/sofra-reminder
# ESCALATION_WEBHOOK_SECRET=PUT_AN_INDEPENDENT_RANDOM_SECRET_MIN_32_CHARACTERS

# Optional first-party photo CDN hostname. Must match the web app's NEXT_PUBLIC_IMAGE_CDN_HOST.
# Merchant product editor refuses remote photo URLs unless this is set.
# Only restaurant-owned/licensed images may be referenced; this does NOT enable uploads.
# PUBLIC_IMAGE_CDN_HOST=assets.bismilsofra.example


# v1.7 real restaurant photo uploads: credentials are SERVER-ONLY and must be
# restricted to a dedicated image bucket/key prefix, never committed.
# S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com/
# S3_BUCKET=bismilsofra-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=REPLACE_WITH_SECRET_ID
# S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# MEDIA_PUBLIC_ORIGIN=https://assets.yourdomain.example
# PUBLIC_IMAGE_CDN_HOST=assets.yourdomain.example
# The public CDN URL must point to exactly this bucket's object keys.
# Both hosts must match NEXT_PUBLIC_IMAGE_CDN_HOST in apps/web.

# Reverse proxy forwarded IPs are NOT trusted by default.
# Configure only the IP ranges of your own reverse proxies, never a wildcard:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.50.1.0/24
# Without a trusted proxy list, shared-NAT customers use one IP rate budget.
# For multiple API replicas use a SHARED edge/gateway rate limiter as well.

# v2.4 worker health is enabled by migration 010, no extra secret.
# Run API, expiry, primary outbox and independent escalation as separate services.
# /v1/admin/alerts exposes only MFA-protected liveness, NOT device receipt.
# Add external uptime monitoring; do not treat /readyz as a worker-alive signal.

# Pilot SSE/real-time events: dedicated PostgreSQL LISTEN needs a SESSION-capable
# connection. DO NOT use transaction-mode PgBouncer / port 6543 here.
# This URL is server-only, needs no secrets in the browser.
# ORDER_EVENTS_LISTEN_DATABASE_URL=postgresql://sofra:...@DIRECT_SESSION_HOST:5432/bismil_sofra
# If LISTEN is disconnected the UI falls back to periodic HTTP reconciliation.

# API listener defaults to 127.0.0.1; containers may require 0.0.0.0.
# Use 0.0.0.0 ONLY inside restricted container networks behind HTTPS ingress.
# API_BIND_HOST=0.0.0.0
# PORT=4000
# Production order intake defaults CLOSED, even if the API and DB are ready.
# PILOT_ACCEPT_ORDERS=true
# Enabling requires a real HTTPS CORS_ORIGIN and independent HTTPS alert
# endpoints/secrets as configured above; do not turn on before operator approval,
# real provider delivery, backups, staging capacity and device tests.
